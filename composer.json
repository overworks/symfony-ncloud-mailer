{
    "name": "minhyung/ncloud-mailer",
    "description": "Symfony Mailer for Cloud Outbound Mailer",
    "type": "library",
    "keywords": ["mail", "symfony", "mailer", "ncloud"],
    "license": "MIT",
    "authors": [
        {
            "name": "Minhyung Park",
            "email": "urlinee@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/overworks/symfony-ncloud-mailer/issues",
        "source": "https://github.com/overworks/symfony-ncloud-mailer"
    },
    "require": {
        "php": "^8.1",
        "symfony/http-client": "^6.4|^7.1",
        "symfony/mailer": "^6.4|^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Minhyung\\Ncloud\\Mailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Minhyung\\Ncloud\\Mailer\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
